<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Debugger DAP Plugin wx3.3.x(64 bit)" />
		<Option default_target="plugin" />
		<Option compiler="gcc" />
		<Option show_notes="1">
			<notes>
				<![CDATA[Make sure that the order of Virtual targets in the .cbp file is:
<VirtualTargets>
    <Add alias="All" targets="libwxdap;plugin;" />
</VirtualTargets>

	]]>
			</notes>
		</Option>
		<Build>
			<Target title="libwxdap">
				<Option output="../../../devel33_64/debugger_wxdap" prefix_auto="0" extension_auto="1" />
				<Option working_dir="../../../devel33_64" />
				<Option object_output="../../../.objs33_64/debugger_wxdap" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option createStaticLib="1" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-std=c++17" />
					<Add option="-m64" />
					<Add option="-gdwarf-4" />
					<Add option="-O0" />
				</Compiler>
				<Linker>
					<Add option="-m64" />
				</Linker>
				<ExtraCommands>
					<Add before="cmd /c echo TARGET_OUTPUT_DIR: $(TARGET_OUTPUT_DIR)" />
					<Add before="cmd /c echo TARGET_OUTPUT_BASENAME: $(TARGET_OUTPUT_BASENAME)" />
				</ExtraCommands>
			</Target>
			<Target title="plugin">
				<Option output="../../../devel33_64/share/codeblocks/plugins/debugger_dap" prefix_auto="0" extension_auto="1" />
				<Option working_dir="../../../devel33_64" />
				<Option object_output="../../../.objs33_64/plugins/debugger_dap" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option parameters="--debug-log --no-dde --no-check-associations --multiple-instance --no-splash-screen --verbose -p cbDebug333wk" />
				<Option host_application="../../../devel33_64/codeblocks.exe" />
				<Option run_host_application_in_terminal="0" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-std=c++17" />
					<Add option="-m64" />
					<Add option="-gdwarf-4" />
					<Add option="-O0" />
				</Compiler>
				<Linker>
					<Add option="-m64" />
				</Linker>
				<ExtraCommands>
					<Add before="cmd /c echo TARGET_OUTPUT_DIR: $(TARGET_OUTPUT_DIR)" />
					<Add before="cmd /c echo TARGET_OUTPUT_BASENAME: $(TARGET_OUTPUT_BASENAME)" />
					<Add before="cmd /c echo #WX33_64.lib)\gcc_dll$(WX_CFG: $(#WX33_64.lib)\gcc_dll$(WX_CFG)" />
					<Add after="cmd /c if not exist $(TARGET_OUTPUT_DIR) mkdir $(TARGET_OUTPUT_DIR)" />
					<Add after="cmd /c if exist ..\..\..\devel33_64\$(TARGET_OUTPUT_BASENAME).zip del ..\..\..\devel33_64\$(TARGET_OUTPUT_BASENAME).zip" />
					<Add after="zip -jq9 ..\..\..\devel33_64\share\codeblocks\$(TARGET_OUTPUT_BASENAME).zip resources/manifest.xml resources/*.xrc" />
					<Mode after="always" />
				</ExtraCommands>
			</Target>
			<Environment>
				<Variable name="WX_CFG" value="" />
				<Variable name="WX_SUFFIX" value="u" />
				<Variable name="WX_VERSION" value="33" />
			</Environment>
		</Build>
		<VirtualTargets>
			<Add alias="All" targets="libwxdap;plugin;" />
		</VirtualTargets>
		<Compiler>
			<Add option="$(#CB_RELEASE_TYPE)" />
			<Add option="-pipe" />
			<Add option="-fmessage-length=0" />
			<Add option="-fexceptions" />
			<Add option="-mthreads" />
			<Add option="-fno-keep-inline-dllexport" />
			<Add option="-DBUILDING_PLUGIN" />
			<Add option="-DHAVE_W32API_H" />
			<Add option="-D__WXMSW__" />
			<Add option="-DWXUSINGDLL" />
			<Add option="-DcbDEBUG" />
			<Add option="-DwxUSE_UNICODE" />
			<Add option="-D_WIN64" />
			<Add directory="." />
			<Add directory="DebugAdapterClient" />
			<Add directory="DebugAdapterProtocol" />
			<Add directory="F:/usr/Proj/debuggerDAP/Debugger_DAP/src/" />
			<Add directory="./src" />
			<Add directory="./tinyxml2" />
			<Add directory="$(#cb)/include" />
			<Add directory="$(#cb)/include/tinyxml" />
			<Add directory="$(#cb)/sdk/wxscintilla/include" />
			<Add directory="$(#WX33_64.include)" />
			<Add directory="$(#WX33_64.lib)/gcc_dll$(WX_CFG)/msw$(WX_SUFFIX)" />
			<Add directory="F:/usr/Proj/wxWidgets333/include" />
		</Compiler>
		<ResourceCompiler>
			<Add directory="$(#WX33_64.include)" />
			<Add directory="$(#WX33_64)/lib/gcc_dll$(WX_CFG)/msw$(WX_SUFFIX)" />
		</ResourceCompiler>
		<Linker>
			<Add option="-mthreads" />
			<Add option="-Wl,--enable-auto-image-base" />
			<Add option="-Wl,--add-stdcall-alias" />
			<Add option="-Wl,--enable-auto-import" />
			<Add option="-Wl,--no-undefined" />
			<Add library="wxmsw$(WX_VERSION)$(WX_SUFFIX)" />
			<Add library="ws2_32" />
			<Add library="codeblocks" />
			<Add library="debugger_wxdap" />
			<Add directory="../../../devel33_64" />
			<Add directory="$(#WX33_64.lib)/gcc_dll$(WX_CFG)" />
			<Add directory="$(#cb)/devel33_64" />
		</Linker>
		<Unit filename="DebugAdapterClient/DAP_Breakpoints.cpp">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/DAP_Breakpoints.h">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/DAP_CallStack.cpp">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/DAP_CallStack.h">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/DAP_Debugger_State.cpp">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/DAP_Debugger_State.h">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/DAP_Terminal_Panel.cpp">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/DAP_Terminal_Panel.h">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/DAP_Watches.cpp">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/DAP_Watches.h">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/debugger_logger.cpp">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/debugger_logger.h">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/definitions.cpp">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/definitions.h">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/dlg_ProjectOptions.cpp">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/dlg_ProjectOptions.h">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/dlg_SettingsOptions.cpp">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/dlg_SettingsOptions.h">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/dlg_WatchEdit.cpp">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/dlg_WatchEdit.h">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/dlg_databreakpoint.cpp">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/dlg_databreakpoint.h">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/dlg_editbreakpoint.cpp">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/dlg_editbreakpoint.h">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/helpers.cpp">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/helpers.h">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/plugin.cpp">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterClient/plugin.h">
			<Option target="plugin" />
		</Unit>
		<Unit filename="DebugAdapterProtocol/CMakeLists.txt">
			<Option target="libwxdap" />
		</Unit>
		<Unit filename="DebugAdapterProtocol/Client.cpp" />
		<Unit filename="DebugAdapterProtocol/Client.hpp" />
		<Unit filename="DebugAdapterProtocol/ConnectionString.cpp" />
		<Unit filename="DebugAdapterProtocol/ConnectionString.hpp" />
		<Unit filename="DebugAdapterProtocol/DAPEvent.cpp" />
		<Unit filename="DebugAdapterProtocol/DAPEvent.hpp" />
		<Unit filename="DebugAdapterProtocol/Exception.cpp" />
		<Unit filename="DebugAdapterProtocol/Exception.hpp" />
		<Unit filename="DebugAdapterProtocol/JSON.cpp" />
		<Unit filename="DebugAdapterProtocol/JSON.hpp" />
