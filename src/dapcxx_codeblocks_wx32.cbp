<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Debugger WXDAP DLL" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debugger_WXDAP">
				<Option output="../../../../devel32/debugger_wxdap" prefix_auto="0" extension_auto="1" />
				<Option working_dir="../../../../devel32" />
				<Option object_output="../../../../.objs32/debugger_wxdap" />
				<Option type="3" />
				<Option createStaticLib="1" />
				<Option projectLinkerOptionsRelation="2" />
			</Target>
			<Environment>
				<Variable name="WX_CFG" value="" />
				<Variable name="WX_SUFFIX" value="u" />
				<Variable name="WX_VERSION" value="32" />
			</Environment>
		</Build>
		<VirtualTargets>
			<Add alias="All" targets="Debugger_WXDAP" />
		</VirtualTargets>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-std=c++11" />
			<Add option="$(#CB_RELEASE_TYPE)" />
			<Add option="-pipe" />
			<Add option="-fmessage-length=0" />
			<Add option="-fexceptions" />
			<Add option="-mthreads" />
			<Add option="-fno-keep-inline-dllexport" />
			<Add option="-DBUILDING_PLUGIN" />
			<Add option="-DHAVE_W32API_H" />
			<Add option="-D__WXMSW__" />
			<Add option="-DWXUSINGDLL" />
			<Add option="-DcbDEBUG" />
			<Add option="-DwxUSE_UNICODE" />
			<Add option="-D_WIN32" />
			<Add directory="." />
			<Add directory="$(#WX32.include)" />
			<Add directory="$(#WX32.lib)/gcc_dll$(WX_CFG)/msw$(WX_SUFFIX)" />
		</Compiler>
		<ResourceCompiler>
			<Add directory="$(#WX32.include)" />
			<Add directory="$(#WX32)/lib/gcc_dll$(WX_CFG)/msw$(WX_SUFFIX)" />
		</ResourceCompiler>
		<Linker>
			<Add option="-mthreads" />
			<Add option="-Wl,--enable-auto-image-base" />
			<Add option="-Wl,--add-stdcall-alias" />
			<Add option="-Wl,--enable-auto-import" />
			<Add option="-Wl,--no-undefined" />
			<Add library="wxmsw$(WX_VERSION)$(WX_SUFFIX)" />
			<Add directory="$(#WX32.lib)/gcc_dll$(WX_CFG)" />
			<Add library="ws2_32" />
		</Linker>
		<Unit filename="src\manifest.rc" >
			<Option compilerVar="WINDRES" />
		</Unit>
		<Unit filename="src\cJSON.cpp"/>
		<Unit filename="src\cJSON.hpp"/>
		<Unit filename="src\Client.cpp"/>
		<Unit filename="src\Client.hpp"/>
		<Unit filename="src\CMakeLists.txt"/>
		<Unit filename="src\ConnectionString.cpp"/>
		<Unit filename="src\ConnectionString.hpp"/>
		<Unit filename="src\dap.cpp"/>
		<Unit filename="src\dap.hpp"/>
		<Unit filename="src\DAPEvent.cpp"/>
		<Unit filename="src\DAPEvent.hpp"/>
		<Unit filename="src\dap_exports.hpp"/>
		<Unit filename="src\Exception.cpp"/>
		<Unit filename="src\Exception.hpp"/>
		<Unit filename="src\JSON.cpp"/>
		<Unit filename="src\JSON.hpp"/>
		<Unit filename="src\JsonRPC.cpp"/>
		<Unit filename="src\JsonRPC.hpp"/>
		<Unit filename="src\linux.cpp"/>
		<Unit filename="src\Log.cpp"/>
		<Unit filename="src\Log.hpp"/>
		<Unit filename="src\msw.cpp"/>
		<Unit filename="src\Process.cpp"/>
		<Unit filename="src\Process.hpp"/>
		<Unit filename="src\Queue.hpp"/>
		<Unit filename="src\ServerProtocol.cpp"/>
		<Unit filename="src\ServerProtocol.hpp"/>
		<Unit filename="src\Socket.cpp"/>
		<Unit filename="src\Socket.hpp"/>
		<Unit filename="src\SocketClient.cpp"/>
		<Unit filename="src\SocketClient.hpp"/>
		<Unit filename="src\SocketServer.cpp"/>
		<Unit filename="src\SocketServer.hpp"/>
		<Unit filename="src\StringUtils.cpp"/>
		<Unit filename="src\StringUtils.hpp"/>
		<Unit filename="src\UnixProcess.cpp"/>
		<Unit filename="src\UnixProcess.hpp"/>
	</Project>
</CodeBlocks_project_file>
